{
  "name": "box3balans",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "workspaces": [
    "server",
    "web"
  ],
  "scripts": {
    "dev:server": "npm run dev -w server",
    "dev:web": "npm run dev -w web",
    "demo": "npm run demo -w server",
    "build": "npm run build -w server && npm run build -w web",
    "test": "npm test -w server && npm test -w web",
    "coverage": "npm test -w server -- --coverage && npm test -w web -- --coverage && node scripts/coverage-total.js",
    "typecheck": "npm run typecheck -w server && npm run typecheck -w web",
    "lint": "eslint .",
    "lint:scripts": "shellcheck docker-entrypoint.sh scripts/*.sh && actionlint",
    "format": "prettier --write .",
    "screenshots": "node scripts/screenshots.js",
    "check:pages": "node scripts/check-pages.js",
    "build:online-demo": "node scripts/build-online-demo.js",
    "fixtures:demo": "node scripts/demo-fixture.js",
    "prepare": "husky"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitest/coverage-v8": "^5.0.4",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "puppeteer-core": "^25.14.0",
    "typescript-eslint": "^8.71.2"
  },
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": ">=0.25.0"
    }
  }
}

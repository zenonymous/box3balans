# Instellingen voor Box3balans. Alles is optioneel: zonder .env werkt het ook.
# Kopieer dit bestand naar .env (naast docker-compose.yml) en zet alleen wat je wilt veranderen.
# Na een wijziging: docker compose up -d

# Poort waarop Box3balans bereikbaar is: http://<server>:8080
# HTTP_PORT=8080

# Op welk netwerkadres van de server die poort open staat. Standaard op alle, zodat je het vanaf
# andere apparaten thuis bereikt. Draait er een reverse proxy of Tailscale Serve op dezelfde server,
# zet dan 127.0.0.1: dan kan alleen die erbij. Let op: Docker zet een gepubliceerde poort open
# buiten een firewall als ufw om; op een server met een openbaar adres is 127.0.0.1 dus de veilige keus.
# HTTP_BIND=0.0.0.0

# Welke versie je draait: "latest" (de nieuwste uitgave) of een vaste versie, zoals 0.1.35. Met een
# vaste versie werk je bij door hem hier te verhogen; controleer het image eerst met cosign (SECURITY.md).

# BOX3BALANS_VERSION=latest

# De eenmalige code waarmee je de eerste gebruiker aanmaakt. Zonder deze regel bedenkt Box3balans er
# zelf een en zet die in zijn log (docker compose logs app). Alleen nodig als je hem vooraf wilt weten.
# SETUP_CODE=kies-zelf-een-code

# ---- Back-ups ----
# Versleutel de back-ups, zodat een kopie elders (de back-uptool van je NAS, een clouddrive) veilig
# is. Minstens 12 tekens, bijvoorbeeld een paar willekeurige woorden. Bewaar hem in je
# wachtwoordmanager: zonder kun je een versleutelde back-up niet terugzetten. Gebruik enkele
# aanhalingstekens als er een "$" in staat.
# BACKUP_PASSPHRASE='vier willekeurige woorden hier'

# Eigenaar van de back-upbestanden in de map backups: de gebruikers- en groeps-id van je eigen
# gebruiker (het commando `id` toont ze; op Synology vaak 1026 en 100).
# PUID=1000
# PGID=1000

# Om de hoeveel uur een automatische back-up wordt gemaakt (0 = uit) en hoeveel er bewaard blijven.
# Handmatige back-ups worden nooit automatisch verwijderd.
# BACKUP_INTERVAL_HOURS=24
# BACKUP_KEEP=14

# ---- Toegang ----
# Alleen op true zetten als je Box3balans via HTTPS opent (Tailscale HTTPS of een reverse proxy).
# COOKIE_SECURE=false

# Alleen met een reverse proxy ervoor: true, het aantal proxy's, of hun IP-adres(sen).
# Laat op false als je Box3balans rechtstreeks opent.
# TRUST_PROXY=false

# Hoeveel dagen je ingelogd blijft.
# SESSION_DAYS=30

# ---- Ophalen van gegevens ----
# Om de hoeveel minuten koersen worden bijgewerkt. Gratis bronnen begrenzen; 15 is veilig.
# PRICE_REFRESH_MINUTES=15

# Om de hoeveel uur koppelingen met beurzen en brokers en wallets synchroniseren (0 = alleen
# als je zelf op "Sync now" drukt).
# SYNC_INTERVAL_HOURS=6

# Optioneel: een eigen Solana-RPC (bijvoorbeeld een gratis Helius-sleutel) voor snellere eerste imports.
# SOLANA_RPC_URL=

# Optioneel: een gratis Ankr Advanced API-sleutel (ankr.com), nodig om BNB Chain-wallets te volgen.
# ANKR_API_KEY=

# ---- Overig ----
# Tijdzone voor datums, de box 3-peildatum (1 januari) en jaarresultaten.
# TIME_ZONE=Europe/Amsterdam

# Logniveau: fatal, error, warn, info of debug.
# LOG_LEVEL=info

# ---- Zelf kiezen in plaats van laten aanmaken (meestal niet nodig) ----
# Sleutel waarmee de API-sleutels van beurzen versleuteld worden opgeslagen (minstens 32 tekens).
# Zonder deze regel maakt Box3balans er zelf een aan in het app-data-volume.
# APP_SECRET=

# Wachtwoord van de meegeleverde PostgreSQL-database. Alleen van belang bij het allereerste starten:
# daarna staat het in de database. Zonder deze regel maakt Box3balans er zelf een aan.
# POSTGRES_PASSWORD=

# Naam van de database en de databasegebruiker. Alleen aanpassen voor een bestaande database met
# een andere naam.
# DB_NAME=box3balans

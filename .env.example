# Copy to .env and fill in. Never commit .env.

# Password for the bundled PostgreSQL database (any long random string; if it contains "$",
# wrap it in single quotes so Docker Compose doesn't expand it).
#   openssl rand -hex 24
POSTGRES_PASSWORD=

# Secret used to encrypt exchange API keys at rest. At least 32 characters; keep it safe —
# losing it means re-entering API keys.
#   openssl rand -hex 32
APP_SECRET=

# Port the dashboard is published on, on the host.
HTTP_PORT=8080

# Set to true only when the dashboard is served over HTTPS (e.g. behind a reverse proxy).
COOKIE_SECURE=false

# Only when a reverse proxy sits in front: lets the app see real client IPs (for the login rate
# limit). "true", a number of proxy hops, or the proxy's IP(s). Leave false when reached directly.
TRUST_PROXY=false

# Calendar used for dates, the Box 3 peildatum (1 January) and yearly results.
TIME_ZONE=Europe/Amsterdam

# How long a login lasts, in days.
SESSION_DAYS=30

# How often prices are refreshed, in minutes. Free APIs rate-limit; 15 is a safe default.
PRICE_REFRESH_MINUTES=15

# How often exchange/broker connections sync, in hours. 0 = only when you press "Sync now".
SYNC_INTERVAL_HOURS=6

# Log level: fatal, error, warn, info, debug.
LOG_LEVEL=info

# Optional: your own Solana RPC endpoint (e.g. a free Helius/QuickNode key) for faster first imports.
# SOLANA_RPC_URL=

# Optional: a free Ankr Advanced API key (ankr.com), needed to track BNB Chain wallets.
# ANKR_API_KEY=

# Backups (gzipped JSON of all data) go to the ./backups folder next to docker-compose.yml.
# Encrypt them, so a copy off-site (your NAS backup tool, a cloud drive) is safe: at least 12
# characters, ideally a few random words. Keep it in your password manager; without it the backups
# can't be restored. Wrap it in single quotes if it contains "$".
BACKUP_PASSPHRASE=
# Owner of the backup files: your NAS user's ids (`id` on the NAS; Synology users are often 1026/100).
PUID=1000
PGID=1000
# Hours between automatic backups (0 = off; "Back up now" in Settings still works).
BACKUP_INTERVAL_HOURS=24
# Number of automatic backups to keep. Manual and pre-restore backups are never deleted.
BACKUP_KEEP=14
